### Crear producto - Laptop
POST http://localhost:8080/products
Content-Type: application/json
Authorization: Basic Y3VzdG9tZXI6NjU0MzIx

{
  "name": "EXAMPLE",
  "price": 523.99,
  "stock": 4,
  "category": "COMPUTERS",
  "description": "Laptop para gaming con procesador Intel i7, 16GB RAM y tarjeta gráfica NVIDIA RTX 3060",
  "imageUrl": "https://example.com/images/laptop-asus.jpg"
}

### 
POST http://localhost:8080/products
Content-Type: application/json
Authorization: Basic cGVwZTo2NTQzMjE=

{
  "name": "Smartphone Samsung Galaxy S21",
  "price": 799.99,
  "stock": 25,
  "category": "SMARTPHONES",
  "description": "Smartphone con pantalla AMOLED, cámara de 64MP y batería de larga duración",
  "imageUrl": "https://example.com/images/samsung-galaxy-s21.jpg"
}



